# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/influencer_ops

# Redis
REDIS_URL=redis://localhost:6379/0

# Gmail OAuth
# Download credentials from Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Slack
# Create a Slack App at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=C0123456789

# HubSpot
# Get API key from HubSpot -> Settings -> Integrations -> API Key
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-portal-id

# Notion
# Create integration at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-notion-api-key
NOTION_SOP_DATABASE_ID=your-database-id

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-api-key
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Agent Settings
AGENT_MODE=copilot
AUTOPILOT_CONFIDENCE_THRESHOLD=0.9

# Guardrails
PII_MASKING_ENABLED=true
MAX_DRAFT_LENGTH=5000
